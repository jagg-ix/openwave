model:m9_cat_ept#negative_count@value:1.

RULE missing_formal_term_blocks_equation_identity:
IF formalization:current_target_interaction#contains@?term AND numerical:legacy_stationary_equation#omits@?term
THEN numerical:legacy_stationary_equation#status@state:not_current_formal_equation.

RULE out_of_domain_result_is_not_contradiction:
IF ?result#does_not_imply@?contradiction
THEN ?contradiction#status@state:not_established.

RULE open_reconciliation_boundary_preserves_partial:
IF result:m9_99_reconciliation#boundary@?obligation
THEN criterion:magnetic_moment_spin#status@state:partial.

RULE no_reconciliation_promotion:
IF result:m9_99_reconciliation#boundary@?obligation
THEN criterion:electric_force#status@state:partial.

QUERY equation_mismatches:
FIND ?relation WHERE result:formal_numerical_terms_machine_classified#includes@?relation.

QUERY reconciled_operators:
FIND ?operator WHERE engine:periodic_fourier_differential_complex#provides@?operator.

QUERY remaining_reconciliation_obligations:
FIND ?obligation WHERE result:m9_99_reconciliation#boundary@?obligation.

QUERY retained_partial_rows:
FIND ?criterion WHERE ?criterion#status@state:partial.
