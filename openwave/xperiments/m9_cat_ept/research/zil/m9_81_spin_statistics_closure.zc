MODULE openwave.m9.spin_statistics_closure.

criterion:spin_half_statistics#status@status:validated_in_platform.
criterion:spin_half_statistics#supported_by@evidence:m9_29_double_cover.
criterion:spin_half_statistics#supported_by@evidence:m9_81_two_state_antisymmetry.
criterion:spin_half_statistics#supported_by@proof:FieldStatistic.fermionic_exchangeSign_fermionic.
criterion:spin_half_statistics#supported_by@proof:Physlib.QFT.PerturbationTheory.FieldStatistics.PauliExchange.antisymmetrize_self.
criterion:spin_half_statistics#boundary@obligation:derive_fermionic_assignment_for_specific_cat_ept_particle.
criterion:spin_half_statistics#boundary@obligation:physical_electron_identification.

QUERY closure_support:
FIND ?evidence WHERE criterion:spin_half_statistics#supported_by@?evidence.

QUERY retained_boundaries:
FIND ?obligation WHERE criterion:spin_half_statistics#boundary@?obligation.
