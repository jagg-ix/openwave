RULE preserve_partial_without_stationary_branch:
IF ?criterion#supported_by@?result AND ?criterion#blocked_by@result:no_passing_charged_stationary_candidate
THEN ?criterion#status@state:partial.

QUERY charged_branch_result:
FIND ?result WHERE campaign:m9_96a#result@?result.

QUERY source_closures:
FIND ?result WHERE campaign:m9_96b#establishes@?result.

QUERY force_closures:
FIND ?result WHERE campaign:m9_96c#establishes@?result.

QUERY retained_partial_rows:
FIND ?criterion WHERE ?criterion#status@state:partial.

QUERY remaining_obligations:
FIND ?obligation WHERE result:field_force_triangle_agreement#boundary@?obligation.
