RULE no_formal_availability_promotion:
IF ?criterion#supported_by@?bridge AND ?bridge#boundary@?obligation
THEN ?criterion#status@state:partial.

RULE no_formal_source_promotion:
IF ?criterion#supported_by@?formalization AND ?formalization#boundary@?obligation
THEN ?criterion#status@state:partial.

QUERY imported_graphs:
FIND ?graph WHERE formalization:cat_ept_inventory#contains@?graph.

QUERY gravity_boundaries:
FIND ?obligation WHERE formalization:eddington_affine_first_integral#boundary@?obligation.

QUERY spin_boundaries:
FIND ?obligation WHERE bridge:m9_94_canonical_spin_magnetic#boundary@?obligation.

QUERY force_boundaries:
FIND ?obligation WHERE bridge:m9_95_canonical_force_formal#boundary@?obligation.
