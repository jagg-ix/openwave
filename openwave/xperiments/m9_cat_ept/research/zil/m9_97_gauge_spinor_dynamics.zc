RULE no_dynamics_subreduction_promotion:
IF ?criterion#supported_by@?result AND ?result#status@state:closed_dimensionless AND ?criterion#boundary@?obligation
THEN ?criterion#status@state:partial.

RULE failed_reduction_blocks_promotion:
IF ?result#blocks@?criterion AND ?result#status@?failure
THEN ?criterion#status@state:partial.

QUERY closed_dynamics_subreductions:
FIND ?result WHERE ?result#status@state:closed_dimensionless.

QUERY failed_dynamics_reductions:
FIND ?result ?state WHERE ?result#status@?state.

QUERY retained_partial_rows:
FIND ?criterion WHERE ?criterion#status@state:partial.
