RULE historical_pin_not_current:
IF runtime:zil_lean#supersedes@?sha AND ?sha#status@?historical
THEN ?sha#authority@state:historical_only.

RULE native_graph_root_is_explicit:
IF root:zil_native#executes@?graph
THEN ?graph#runtime_root@root:zil_native.

RULE no_runtime_upgrade_promotion:
IF runtime:zil_lean#does_not_promote@?criterion
THEN ?criterion#status@state:partial.

QUERY current_runtime:
FIND ?head WHERE runtime:zil_lean#head@?head.

QUERY historical_pins:
FIND ?sha ?state WHERE runtime:zil_lean#supersedes@?sha AND ?sha#status@?state.

QUERY native_graphs:
FIND ?graph WHERE root:zil_native#executes@?graph.

QUERY retained_partial_rows:
FIND ?criterion WHERE runtime:zil_lean#does_not_promote@?criterion.
